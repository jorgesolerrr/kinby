# Copy to .env. Compose passes these to the container; kinby also reads .env directly.
# Leave empty to use the `ant auth login` profile Compose mounts; a set key overrides it.
ANTHROPIC_API_KEY=
# GitHub token with repo scope: gh, git push, and issue/PR operations run as this identity.
GH_TOKEN=
# Shared secret of the repository webhook that signs each delivery.
GITHUB_WEBHOOK_SECRET=
# Commit identity inside the container.
GIT_USER_NAME=
GIT_USER_EMAIL=
