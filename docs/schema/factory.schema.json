{
  "$defs": {
    "ApproveStep": {
      "additionalProperties": false,
      "description": "Park the run until the user approves it or sends it back.",
      "properties": {
        "failed": {
          "anyOf": [
            {
              "$ref": "#/$defs/SendBack"
            },
            {
              "$ref": "#/$defs/Retry"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failed"
        },
        "id": {
          "$ref": "#/$defs/StepId"
        },
        "kind": {
          "const": "approve",
          "title": "Kind",
          "type": "string"
        },
        "outcomes": {
          "additionalProperties": {
            "$ref": "#/$defs/Outcome"
          },
          "title": "Outcomes",
          "type": "object"
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Requires",
          "type": "array"
        },
        "results": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueType"
          },
          "propertyNames": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Results",
          "type": "object"
        },
        "retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "summary"
      ],
      "title": "ApproveStep",
      "type": "object"
    },
    "Closing": {
      "additionalProperties": false,
      "description": "The signals that say a run's work finished elsewhere, which end a run that needs human.\n\nA signal matching one of the ``done`` filters ends it done, and one matching a ``cancelled``\nfilter ends it cancelled. A filter matches as a wait's does.",
      "properties": {
        "cancelled": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SignalFilter"
          },
          "title": "Cancelled",
          "type": "array"
        },
        "done": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SignalFilter"
          },
          "title": "Done",
          "type": "array"
        }
      },
      "title": "Closing",
      "type": "object"
    },
    "CodingModel": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/\\[\\]-]*$",
      "type": "string"
    },
    "CommandListName": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "Duration": {
      "pattern": "^[1-9][0-9]*[smhd]$",
      "type": "string"
    },
    "Engine": {
      "description": "What runs an agent step: a kinby turn, or a coding client, which keeps a session.",
      "enum": [
        "kinby",
        "claude",
        "codex"
      ],
      "title": "Engine",
      "type": "string"
    },
    "FactoryName": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "FactoryPath": {
      "minLength": 1,
      "type": "string"
    },
    "HookName": {
      "minLength": 1,
      "type": "string"
    },
    "IntakeDelivery": {
      "additionalProperties": false,
      "description": "Deliveries that fire the intake, each authenticated as a routine's signal is.",
      "properties": {
        "auth": {
          "$ref": "#/$defs/SignalAuth",
          "default": "token"
        },
        "delivery_header": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Header"
        },
        "secret": {
          "minLength": 1,
          "title": "Secret",
          "type": "string"
        },
        "signature_header": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature Header"
        }
      },
      "required": [
        "secret"
      ],
      "title": "IntakeDelivery",
      "type": "object"
    },
    "Outcome": {
      "anyOf": [
        {
          "enum": [
            "next",
            "done",
            "stop"
          ],
          "type": "string"
        },
        {
          "$ref": "#/$defs/SendBack"
        }
      ]
    },
    "ReasoningEffort": {
      "description": "How hard a coding client reasons. Codex has no ``max``.",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "title": "ReasoningEffort",
      "type": "string"
    },
    "RecipeName": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "type": "string"
    },
    "RepositoryCommands": {
      "additionalProperties": false,
      "description": "The instance's list of repository commands named *commands*, in a command step's run.\n\nThe instance reads the list when the step runs. Its commands run as written, with no run\nvalues.",
      "properties": {
        "commands": {
          "$ref": "#/$defs/CommandListName"
        }
      },
      "required": [
        "commands"
      ],
      "title": "RepositoryCommands",
      "type": "object"
    },
    "RequiredField": {
      "additionalProperties": false,
      "description": "A secret or a named value a factory requires: a setup field with no kind and no target.",
      "properties": {
        "choices": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choices"
        },
        "default": {
          "anyOf": [
            {
              "$ref": "#/$defs/SetupValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/SetupFieldType"
        }
      },
      "required": [
        "name",
        "label",
        "description",
        "type",
        "required"
      ],
      "title": "RequiredField",
      "type": "object"
    },
    "Requirements": {
      "additionalProperties": false,
      "description": "What a workbench must provide for the factory's steps to run on it.",
      "properties": {
        "browser": {
          "default": false,
          "title": "Browser",
          "type": "boolean"
        },
        "commands": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CommandListName"
          },
          "title": "Commands",
          "type": "array"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecipeName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "logins": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SubscriptionLogin"
          },
          "title": "Logins",
          "type": "array"
        },
        "secrets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RequiredField"
          },
          "title": "Secrets",
          "type": "array"
        },
        "suggested_picks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Suggested Picks",
          "type": "array"
        },
        "values": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RequiredField"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "title": "Requirements",
      "type": "object"
    },
    "Retry": {
      "additionalProperties": false,
      "description": "Run the step again after a failed attempt, at most ``retry`` times.",
      "properties": {
        "retry": {
          "minimum": 1,
          "title": "Retry",
          "type": "integer"
        }
      },
      "required": [
        "retry"
      ],
      "title": "Retry",
      "type": "object"
    },
    "SendBack": {
      "additionalProperties": false,
      "description": "Send the work back to an earlier step, at most ``max`` times along this edge.",
      "properties": {
        "back": {
          "$ref": "#/$defs/StepId"
        },
        "max": {
          "minimum": 1,
          "title": "Max",
          "type": "integer"
        }
      },
      "required": [
        "back",
        "max"
      ],
      "title": "SendBack",
      "type": "object"
    },
    "SetupFieldType": {
      "description": "How a client asks for a setup field's value, and so what the value is.",
      "enum": [
        "text",
        "multiline",
        "boolean",
        "integer",
        "choice",
        "email",
        "url"
      ],
      "title": "SetupFieldType",
      "type": "string"
    },
    "SetupValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "SignalAuth": {
      "enum": [
        "token",
        "hmac-sha256"
      ],
      "title": "SignalAuth",
      "type": "string"
    },
    "SignalField": {
      "pattern": "^(routine|headers\\.[A-Za-z0-9-]+|body(\\.[^.]+)+)$",
      "type": "string"
    },
    "SignalFilter": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/SignalField"
      },
      "type": "object"
    },
    "StepId": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "SubscriptionLogin": {
      "additionalProperties": false,
      "description": "One sign-in a template declares, run in a setup container (ADR 0065).",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "prompt_pattern": {
          "title": "Prompt Pattern",
          "type": "string"
        },
        "volume": {
          "title": "Volume",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "command",
        "volume",
        "prompt_pattern"
      ],
      "title": "SubscriptionLogin",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "description": "A tool of the factory's folder the hub calls on the workbench, as ``needs_human``, ``ended``\nor ``worktree``. The tool's parameters named like a value of the run receive that value.",
      "properties": {
        "call": {
          "$ref": "#/$defs/ToolName"
        }
      },
      "required": [
        "call"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "ToolName": {
      "minLength": 1,
      "type": "string"
    },
    "ValueName": {
      "pattern": "^[a-z_][a-z0-9_]*$",
      "type": "string"
    },
    "ValueType": {
      "enum": [
        "str",
        "int",
        "bool"
      ],
      "title": "ValueType",
      "type": "string"
    },
    "WaitStep": {
      "additionalProperties": false,
      "description": "Park the run until a signal matches one of the filters, or its quiet time or its deadline\npasses, whichever comes first.\n\nA signal matches a filter when it carries every field of the filter, each of the same type and\nvalue. A field the signal lacks never matches.",
      "properties": {
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failed": {
          "anyOf": [
            {
              "$ref": "#/$defs/SendBack"
            },
            {
              "$ref": "#/$defs/Retry"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failed"
        },
        "id": {
          "$ref": "#/$defs/StepId"
        },
        "kind": {
          "const": "wait",
          "title": "Kind",
          "type": "string"
        },
        "outcomes": {
          "additionalProperties": {
            "$ref": "#/$defs/Outcome"
          },
          "title": "Outcomes",
          "type": "object"
        },
        "quiet": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Requires",
          "type": "array"
        },
        "results": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueType"
          },
          "propertyNames": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Results",
          "type": "object"
        },
        "retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry"
        },
        "signal": {
          "items": {
            "$ref": "#/$defs/SignalFilter"
          },
          "minItems": 1,
          "title": "Signal",
          "type": "array"
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "signal",
        "id",
        "kind"
      ],
      "title": "WaitStep",
      "type": "object"
    },
    "WorkbenchAgentStep": {
      "additionalProperties": false,
      "description": "A model doing the work from a prompt of the factory's folder, on the workbench in the run's\nfolder, run by its engine.",
      "properties": {
        "check": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningEffort"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "engine": {
          "$ref": "#/$defs/Engine"
        },
        "failed": {
          "anyOf": [
            {
              "$ref": "#/$defs/SendBack"
            },
            {
              "$ref": "#/$defs/Retry"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failed"
        },
        "id": {
          "$ref": "#/$defs/StepId"
        },
        "kind": {
          "const": "agent",
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodingModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcomes": {
          "additionalProperties": {
            "$ref": "#/$defs/Outcome"
          },
          "title": "Outcomes",
          "type": "object"
        },
        "prompt": {
          "$ref": "#/$defs/FactoryPath"
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Requires",
          "type": "array"
        },
        "results": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueType"
          },
          "propertyNames": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Results",
          "type": "object"
        },
        "resume": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry"
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "engine",
        "prompt"
      ],
      "title": "WorkbenchAgentStep",
      "type": "object"
    },
    "WorkbenchCodeStep": {
      "additionalProperties": false,
      "description": "A tool of the factory's folder, run on the workbench. The model never sees it.\n\nA mapping the tool returns is the step's values. A HookResult also names its outcome.",
      "properties": {
        "call": {
          "$ref": "#/$defs/ToolName"
        },
        "check": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failed": {
          "anyOf": [
            {
              "$ref": "#/$defs/SendBack"
            },
            {
              "$ref": "#/$defs/Retry"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failed"
        },
        "id": {
          "$ref": "#/$defs/StepId"
        },
        "kind": {
          "const": "code",
          "title": "Kind",
          "type": "string"
        },
        "outcomes": {
          "additionalProperties": {
            "$ref": "#/$defs/Outcome"
          },
          "title": "Outcomes",
          "type": "object"
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Requires",
          "type": "array"
        },
        "results": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueType"
          },
          "propertyNames": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Results",
          "type": "object"
        },
        "retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry"
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "call"
      ],
      "title": "WorkbenchCodeStep",
      "type": "object"
    },
    "WorkbenchCommandStep": {
      "additionalProperties": false,
      "description": "Commands in the run's folder on the workbench, each run without a shell. Exit code zero\npasses.\n\nA ``{{name}}`` in a command stands for the run's value of that name, as one argument. An\nentry ``{ commands: <name> }`` runs the workbench's list of repository commands of that name.",
      "properties": {
        "check": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failed": {
          "anyOf": [
            {
              "$ref": "#/$defs/SendBack"
            },
            {
              "$ref": "#/$defs/Retry"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failed"
        },
        "id": {
          "$ref": "#/$defs/StepId"
        },
        "kind": {
          "const": "command",
          "title": "Kind",
          "type": "string"
        },
        "outcomes": {
          "additionalProperties": {
            "$ref": "#/$defs/Outcome"
          },
          "title": "Outcomes",
          "type": "object"
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Requires",
          "type": "array"
        },
        "results": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueType"
          },
          "propertyNames": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Results",
          "type": "object"
        },
        "retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry"
        },
        "run": {
          "items": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "$ref": "#/$defs/RepositoryCommands"
              }
            ]
          },
          "minItems": 1,
          "title": "Run",
          "type": "array"
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "run",
        "id",
        "kind"
      ],
      "title": "WorkbenchCommandStep",
      "type": "object"
    },
    "WorkbenchIntake": {
      "additionalProperties": false,
      "description": "What fires a line's intake routine in its owner, a schedule, deliveries or both, and the\ntool of the factory's folder that finds the work items on the line's workbench.\n\nThe tool's ``signal`` parameter receives the delivery that fired it, or an empty mapping. Each\nmapping in the list it returns is a work item for the line.",
      "properties": {
        "call": {
          "$ref": "#/$defs/ToolName"
        },
        "delivery": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntakeDelivery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schedule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule"
        }
      },
      "required": [
        "call"
      ],
      "title": "WorkbenchIntake",
      "type": "object"
    },
    "WorkbenchStep": {
      "discriminator": {
        "mapping": {
          "agent": "#/$defs/WorkbenchAgentStep",
          "approve": "#/$defs/ApproveStep",
          "code": "#/$defs/WorkbenchCodeStep",
