{
  "$defs": {
    "AgentStep": {
      "additionalProperties": false,
      "description": "A kinby turn on a new thread of the instance, with the prompt.",
      "properties": {
        "failed": {
          "anyOf": [
            {
              "$ref": "#/$defs/SendBack"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hook": {
          "$ref": "#/$defs/HookName"
        },
        "id": {
          "$ref": "#/$defs/StepId"
        },
        "in": {
          "$ref": "#/$defs/InstanceName"
        },
        "kind": {
          "const": "agent",
          "title": "Kind",
          "type": "string"
        },
        "outcomes": {
          "additionalProperties": {
            "$ref": "#/$defs/Outcome"
          },
          "title": "Outcomes",
          "type": "object"
        },
        "prompt": {
          "$ref": "#/$defs/FactoryPath"
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Requires",
          "type": "array"
        },
        "results": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueType"
          },
          "propertyNames": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Results",
          "type": "object"
        },
        "retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry"
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "in",
        "id",
        "kind",
        "prompt",
        "hook"
      ],
      "title": "AgentStep",
      "type": "object"
    },
    "ApproveStep": {
      "additionalProperties": false,
      "description": "Park the run until the user approves it or sends it back.",
      "properties": {
        "failed": {
          "anyOf": [
            {
              "$ref": "#/$defs/SendBack"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "$ref": "#/$defs/StepId"
        },
        "kind": {
          "const": "approve",
          "title": "Kind",
          "type": "string"
        },
        "outcomes": {
          "additionalProperties": {
            "$ref": "#/$defs/Outcome"
          },
          "title": "Outcomes",
          "type": "object"
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Requires",
          "type": "array"
        },
        "results": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueType"
          },
          "propertyNames": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Results",
          "type": "object"
        },
        "retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "summary"
      ],
      "title": "ApproveStep",
      "type": "object"
    },
    "ClientStep": {
      "additionalProperties": false,
      "description": "A coding client run directly in the instance's container, with no kinby turn around it.",
      "properties": {
        "client": {
          "$ref": "#/$defs/CodingClient"
        },
        "effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningEffort"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failed": {
          "anyOf": [
            {
              "$ref": "#/$defs/SendBack"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hook": {
          "$ref": "#/$defs/HookName"
        },
        "id": {
          "$ref": "#/$defs/StepId"
        },
        "in": {
          "$ref": "#/$defs/InstanceName"
        },
        "kind": {
          "const": "client",
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodingModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcomes": {
          "additionalProperties": {
            "$ref": "#/$defs/Outcome"
          },
          "title": "Outcomes",
          "type": "object"
        },
        "prompt": {
          "$ref": "#/$defs/FactoryPath"
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Requires",
          "type": "array"
        },
        "results": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueType"
          },
          "propertyNames": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Results",
          "type": "object"
        },
        "resume": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry"
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "in",
        "id",
        "kind",
        "client",
        "prompt",
        "hook"
      ],
      "title": "ClientStep",
      "type": "object"
    },
    "CodeStep": {
      "additionalProperties": false,
      "description": "An instance tool the model never sees.\n\nA mapping the tool returns is the step's values. A HookResult also names its outcome.",
      "properties": {
        "call": {
          "$ref": "#/$defs/ToolName"
        },
        "failed": {
          "anyOf": [
            {
              "$ref": "#/$defs/SendBack"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "$ref": "#/$defs/StepId"
        },
        "in": {
          "$ref": "#/$defs/InstanceName"
        },
        "kind": {
          "const": "code",
          "title": "Kind",
          "type": "string"
        },
        "outcomes": {
          "additionalProperties": {
            "$ref": "#/$defs/Outcome"
          },
          "title": "Outcomes",
          "type": "object"
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Requires",
          "type": "array"
        },
        "results": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueType"
          },
          "propertyNames": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Results",
          "type": "object"
        },
        "retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry"
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "in",
        "id",
        "kind",
        "call"
      ],
      "title": "CodeStep",
      "type": "object"
    },
    "CodingClient": {
      "enum": [
        "claude",
        "codex"
      ],
      "title": "CodingClient",
      "type": "string"
    },
    "CodingModel": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/\\[\\]-]*$",
      "type": "string"
    },
    "CommandStep": {
      "additionalProperties": false,
      "description": "Commands in the instance's workspace, each run without a shell. Exit code zero passes.\n\nA ``{{name}}`` in a command stands for the run's value of that name, as one argument.",
      "properties": {
        "failed": {
          "anyOf": [
            {
              "$ref": "#/$defs/SendBack"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hook": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "$ref": "#/$defs/StepId"
        },
        "in": {
          "$ref": "#/$defs/InstanceName"
        },
        "kind": {
          "const": "command",
          "title": "Kind",
          "type": "string"
        },
        "outcomes": {
          "additionalProperties": {
            "$ref": "#/$defs/Outcome"
          },
          "title": "Outcomes",
          "type": "object"
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Requires",
          "type": "array"
        },
        "results": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueType"
          },
          "propertyNames": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Results",
          "type": "object"
        },
        "retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry"
        },
        "run": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Run",
          "type": "array"
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "in",
        "run",
        "id",
        "kind"
      ],
      "title": "CommandStep",
      "type": "object"
    },
    "Duration": {
      "pattern": "^[1-9][0-9]*[smhd]$",
      "type": "string"
    },
    "FactoryName": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "FactoryPath": {
      "minLength": 1,
      "type": "string"
    },
    "HookName": {
      "minLength": 1,
      "type": "string"
    },
    "InstanceDeclaration": {
      "additionalProperties": false,
      "description": "One instance the factory's steps run in. Its template is ``instances/<name>/``.",
      "properties": {
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecipeName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "logins": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SubscriptionLogin"
          },
          "title": "Logins",
          "type": "array"
        },
        "setup_fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SetupField"
          },
          "title": "Setup Fields",
          "type": "array"
        }
      },
      "title": "InstanceDeclaration",
      "type": "object"
    },
    "InstanceName": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "type": "string"
    },
    "Intake": {
      "additionalProperties": false,
      "description": "The routine that hands the factory its work items, and the instance it runs in.",
      "properties": {
        "instance": {
          "$ref": "#/$defs/InstanceName"
        },
        "routine": {
          "$ref": "#/$defs/RoutineName"
        }
      },
      "required": [
        "instance",
        "routine"
      ],
      "title": "Intake",
      "type": "object"
    },
    "NeedsHumanCall": {
      "additionalProperties": false,
      "description": "An instance tool the hub calls each time a run stops as needs human.\n\nThe tool's parameters named like a value of the run receive that value, ``step`` the step\nthe run stopped at, and ``summary`` the summary of that step's last attempt.",
      "properties": {
        "call": {
          "$ref": "#/$defs/ToolName"
        },
        "in": {
          "$ref": "#/$defs/InstanceName"
        }
      },
      "required": [
        "in",
        "call"
      ],
      "title": "NeedsHumanCall",
      "type": "object"
    },
    "Outcome": {
      "anyOf": [
        {
          "enum": [
            "next",
            "done",
            "stop"
          ],
          "type": "string"
        },
        {
          "$ref": "#/$defs/SendBack"
        }
      ]
    },
    "ReasoningEffort": {
      "description": "How hard a coding client reasons. Codex has no ``max``.",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "title": "ReasoningEffort",
      "type": "string"
    },
    "RecipeName": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "type": "string"
    },
    "RoutineName": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "type": "string"
    },
    "SendBack": {
      "additionalProperties": false,
      "description": "Send the work back to an earlier step, at most ``max`` times along this edge.",
      "properties": {
        "back": {
          "$ref": "#/$defs/StepId"
        },
        "max": {
          "minimum": 1,
          "title": "Max",
          "type": "integer"
        }
      },
      "required": [
        "back",
        "max"
      ],
      "title": "SendBack",
      "type": "object"
    },
    "SetupField": {
      "additionalProperties": false,
      "description": "One value a prepared image or an instance template asks for before an instance exists.",
      "properties": {
        "choices": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choices"
        },
        "default": {
          "anyOf": [
            {
              "$ref": "#/$defs/SetupValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SetupFieldKind"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/SetupTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "$ref": "#/$defs/SetupFieldType"
        }
      },
      "required": [
        "name",
        "label",
        "description",
        "kind",
        "type",
        "required"
      ],
      "title": "SetupField",
      "type": "object"
    },
    "SetupFieldKind": {
      "description": "Where a setup field's value lands: the instance's configuration, or its secrets.",
      "enum": [
        "config",
        "secret"
      ],
      "title": "SetupFieldKind",
      "type": "string"
    },
    "SetupFieldType": {
      "description": "How a client asks for a setup field's value, and so what the value is.",
      "enum": [
        "text",
        "multiline",
        "boolean",
        "integer",
        "choice",
        "email",
        "url"
      ],
      "title": "SetupFieldType",
      "type": "string"
    },
    "SetupTarget": {
      "additionalProperties": false,
      "description": "Where a configuration value lands: a file, and a dotted key inside it.",
      "properties": {
        "file": {
          "$ref": "#/$defs/TargetFile"
        },
        "key": {
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "file",
        "key"
      ],
      "title": "SetupTarget",
      "type": "object"
    },
    "SetupValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "SignalField": {
      "pattern": "^(routine|headers\\.[A-Za-z0-9-]+|body(\\.[^.]+)+)$",
      "type": "string"
    },
    "SignalFilter": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ]
      },
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/SignalField"
      },
      "type": "object"
    },
    "Step": {
      "discriminator": {
        "mapping": {
          "agent": "#/$defs/AgentStep",
          "approve": "#/$defs/ApproveStep",
          "client": "#/$defs/ClientStep",
          "code": "#/$defs/CodeStep",
          "command": "#/$defs/CommandStep",
          "wait": "#/$defs/WaitStep"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AgentStep"
        },
        {
          "$ref": "#/$defs/ClientStep"
        },
        {
          "$ref": "#/$defs/CommandStep"
        },
        {
          "$ref": "#/$defs/CodeStep"
        },
        {
          "$ref": "#/$defs/WaitStep"
        },
        {
          "$ref": "#/$defs/ApproveStep"
        }
      ]
    },
    "StepId": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "SubscriptionLogin": {
      "additionalProperties": false,
      "description": "One sign-in a package or a template declares, run in a setup container (ADR 0065).",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "prompt_pattern": {
          "title": "Prompt Pattern",
          "type": "string"
        },
        "volume": {
          "title": "Volume",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "command",
        "volume",
        "prompt_pattern"
      ],
      "title": "SubscriptionLogin",
      "type": "object"
    },
    "TargetFile": {
      "description": "The instance file a package's configuration field lands in.",
      "enum": [
        "kinby.toml",
        "package.yaml"
      ],
      "title": "TargetFile",
      "type": "string"
    },
    "ToolName": {
      "minLength": 1,
      "type": "string"
    },
    "ValueName": {
      "pattern": "^[a-z_][a-z0-9_]*$",
      "type": "string"
    },
    "ValueType": {
      "enum": [
        "str",
        "int",
        "bool"
      ],
      "title": "ValueType",
      "type": "string"
    },
    "WaitStep": {
      "additionalProperties": false,
      "description": "Park the run until a signal matches one of the filters, or the deadline passes.\n\nA signal matches a filter when it carries every field of the filter, each of the same type and\nvalue. A field the signal lacks never matches.",
      "properties": {
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failed": {
          "anyOf": [
            {
              "$ref": "#/$defs/SendBack"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "$ref": "#/$defs/StepId"
        },
        "kind": {
          "const": "wait",
          "title": "Kind",
          "type": "string"
        },
        "outcomes": {
          "additionalProperties": {
            "$ref": "#/$defs/Outcome"
          },
          "title": "Outcomes",
          "type": "object"
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Requires",
          "type": "array"
        },
        "results": {
          "additionalProperties": {
            "$ref": "#/$defs/ValueType"
          },
          "propertyNames": {
            "$ref": "#/$defs/ValueName"
          },
          "title": "Results",
          "type": "object"
        },
        "retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry"
        },
        "signal": {
          "items": {
            "$ref": "#/$defs/SignalFilter"
          },
          "minItems": 1,
          "title": "Signal",
          "type": "array"
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "signal",
        "id",
        "kind"
      ],
      "title": "WaitStep",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A factory: the instances its steps run in, its intake, and its line of steps.",
  "properties": {
    "done_requires": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ValueName"
      },
      "title": "Done Requires",
      "type": "array"
    },
    "instances": {
      "additionalProperties": {
        "$ref": "#/$defs/InstanceDeclaration"
      },
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/InstanceName"
      },
      "title": "Instances",
      "type": "object"
    },
    "intake": {
      "$ref": "#/$defs/Intake"
    },
    "name": {
      "$ref": "#/$defs/FactoryName"
    },
    "needs_human": {
      "anyOf": [
        {
          "$ref": "#/$defs/NeedsHumanCall"
        },
