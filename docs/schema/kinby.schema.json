{
  "$defs": {
    "FeedbackPolicy": {
      "description": "When kinby asks the user to rate a completed turn.",
      "enum": [
        "every-turn",
        "off"
      ],
      "title": "FeedbackPolicy",
      "type": "string"
    },
    "RawConventions": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "instructions": {
          "default": [
            "AGENTS.md"
          ],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Instructions",
          "type": "array"
        },
        "skills": {
          "default": [
            ".agents/skills"
          ],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        }
      },
      "title": "RawConventions",
      "type": "object"
    },
    "RawFeedback": {
      "additionalProperties": false,
      "properties": {
        "ask": {
          "$ref": "#/$defs/FeedbackPolicy",
          "default": "every-turn"
        }
      },
      "title": "RawFeedback",
      "type": "object"
    },
    "RawMemory": {
      "additionalProperties": false,
      "properties": {
        "recap": {
          "$ref": "#/$defs/RecapPolicy",
          "default": "every-turn"
        }
      },
      "title": "RawMemory",
      "type": "object"
    },
    "RawModelPrice": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "minimum": 0,
          "title": "Input",
          "type": "number"
        },
        "output": {
          "minimum": 0,
          "title": "Output",
          "type": "number"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "title": "RawModelPrice",
      "type": "object"
    },
    "RawModels": {
      "additionalProperties": false,
      "properties": {
        "embed": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[^:\\s]+:[^:\\s]+(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embed"
        },
        "main": {
          "minLength": 1,
          "pattern": "^[^:\\s]+:[^:\\s]+(?![\\s\\S])",
          "title": "Main",
          "type": "string"
        },
        "recap": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[^:\\s]+:[^:\\s]+(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recap"
        }
      },
      "required": [
        "main"
      ],
      "title": "RawModels",
      "type": "object"
    },
    "RawTools": {
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "default": true,
          "title": "Defaults",
          "type": "boolean"
        }
      },
      "title": "RawTools",
      "type": "object"
    },
    "RawWorkspace": {
      "additionalProperties": false,
      "properties": {
        "conventions": {
          "$ref": "#/$defs/RawConventions",
          "default": {
            "enabled": false,
            "instructions": [
              "AGENTS.md"
            ],
            "skills": [
              ".agents/skills"
            ]
          }
        },
        "path": {
          "default": "workspace",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "title": "RawWorkspace",
      "type": "object"
    },
    "RecapPolicy": {
      "description": "When kinby writes a model-assisted recap.",
      "enum": [
        "every-turn",
        "off"
      ],
      "title": "RecapPolicy",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The shape of ``kinby.toml``, validated once at load.",
  "properties": {
    "feedback": {
      "$ref": "#/$defs/RawFeedback",
      "default": {
        "ask": "every-turn"
      }
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "memory": {
      "$ref": "#/$defs/RawMemory",
      "default": {
        "recap": "every-turn"
      }
    },
    "models": {
      "$ref": "#/$defs/RawModels"
    },
    "persona_name": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Persona Name"
    },
    "prices": {
      "additionalProperties": false,
      "patternProperties": {
        "^[^:\\s]+:[^:\\s]+(?![\\s\\S])": {
          "$ref": "#/$defs/RawModelPrice"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Prices",
      "type": "object"
    },
    "state_dir": {
      "default": ".state",
      "minLength": 1,
      "title": "State Dir",
      "type": "string"
    },
    "tools": {
      "$ref": "#/$defs/RawTools",
      "default": {
        "defaults": true
      }
    },
    "workspace": {
      "$ref": "#/$defs/RawWorkspace",
      "default": {
        "conventions": {
          "enabled": false,
          "instructions": [
            "AGENTS.md"
          ],
          "skills": [
            ".agents/skills"
          ]
        },
        "path": "workspace",
        "source": null
      }
    }
  },
  "required": [
    "id",
    "models"
  ],
  "title": "RawManifest",
  "type": "object"
}
