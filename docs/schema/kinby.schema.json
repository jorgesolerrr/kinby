{
  "$defs": {
    "BuiltInToolGroup": {
      "description": "A tool group kinby ships, whose states the manifest holds (ADR 0129). Each MCP server an\ninstance picks is a tool group too.",
      "enum": [
        "defaults",
        "memory",
        "browser",
        "authored"
      ],
      "title": "BuiltInToolGroup",
      "type": "string"
    },
    "CommandListName": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "FeedbackPolicy": {
      "description": "When kinby asks the user to rate a completed turn.",
      "enum": [
        "every-turn",
        "off"
      ],
      "title": "FeedbackPolicy",
      "type": "string"
    },
    "RawBudgets": {
      "additionalProperties": false,
      "properties": {
        "seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seconds"
        },
        "steps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steps"
        },
        "tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "usd_per_day": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usd Per Day"
        }
      },
      "title": "RawBudgets",
      "type": "object"
    },
    "RawCompaction": {
      "additionalProperties": false,
      "properties": {
        "automatic": {
          "default": true,
          "title": "Automatic",
          "type": "boolean"
        },
        "trigger": {
          "default": 100000,
          "exclusiveMinimum": 0,
          "title": "Trigger",
          "type": "integer"
        }
      },
      "title": "RawCompaction",
      "type": "object"
    },
    "RawConventions": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "instructions": {
          "default": [
            "AGENTS.md"
          ],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Instructions",
          "type": "array"
        },
        "skills": {
          "default": [
            ".agents/skills"
          ],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        }
      },
      "title": "RawConventions",
      "type": "object"
    },
    "RawFeedback": {
      "additionalProperties": false,
      "properties": {
        "ask": {
          "$ref": "#/$defs/FeedbackPolicy",
          "default": "every-turn"
        }
      },
      "title": "RawFeedback",
      "type": "object"
    },
    "RawMemory": {
      "additionalProperties": false,
      "properties": {
        "recap": {
          "$ref": "#/$defs/RecapPolicy",
          "default": "every-turn"
        }
      },
      "title": "RawMemory",
      "type": "object"
    },
    "RawModelPrice": {
      "additionalProperties": false,
      "properties": {
        "cache_read": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read"
        },
        "cache_write": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write"
        },
        "input": {
          "minimum": 0,
          "title": "Input",
          "type": "number"
        },
        "output": {
          "minimum": 0,
          "title": "Output",
          "type": "number"
        },
        "window": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "title": "RawModelPrice",
      "type": "object"
    },
    "RawModels": {
      "additionalProperties": false,
      "properties": {
        "embed": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[^:\\s]+:[^:\\s]+(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embed"
        },
        "main": {
          "minLength": 1,
          "pattern": "^[^:\\s]+:[^:\\s]+(?![\\s\\S])",
          "title": "Main",
          "type": "string"
        },
        "recap": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[^:\\s]+:[^:\\s]+(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recap"
        }
      },
      "required": [
        "main"
      ],
      "title": "RawModels",
      "type": "object"
    },
    "RawRoutines": {
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "default": "UTC",
          "title": "Timezone",
          "type": "string"
        }
      },
      "title": "RawRoutines",
      "type": "object"
    },
    "RawServe": {
      "additionalProperties": false,
      "properties": {
        "listen": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*:[0-9]+(?![\\s\\S])",
          "title": "Listen",
          "type": "string"
        }
      },
      "required": [
        "listen"
      ],
      "title": "RawServe",
      "type": "object"
    },
    "RawTools": {
      "additionalProperties": false,
      "description": "The `[tools]` table. Each built-in tool group is on and loaded unless it changes that\n(ADR 0129).",
      "properties": {
        "authored": {
          "default": true,
          "title": "Authored",
          "type": "boolean"
        },
        "bash_timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "title": "Bash Timeout Seconds",
          "type": "integer"
        },
        "default_states": {
          "additionalProperties": {
            "$ref": "#/$defs/ToolState"
          },
          "default": {},
          "propertyNames": {
            "$ref": "#/$defs/BuiltInToolGroup"
          },
          "title": "Default States",
          "type": "object"
        },
        "defaults": {
          "default": true,
          "title": "Defaults",
          "type": "boolean"
        },
        "memory": {
          "default": true,
          "title": "Memory",
          "type": "boolean"
        },
        "search": {
          "$ref": "#/$defs/SearchBackend",
          "default": "brave"
        },
        "states": {
          "additionalProperties": {
            "$ref": "#/$defs/ToolState"
          },
          "default": {},
          "propertyNames": {
            "minLength": 1
          },
          "title": "States",
          "type": "object"
        }
      },
      "title": "RawTools",
      "type": "object"
    },
    "RawWorkspace": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "additionalProperties": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "$ref": "#/$defs/CommandListName"
          },
          "title": "Commands",
          "type": "object"
        },
        "conventions": {
          "$ref": "#/$defs/RawConventions",
          "default": {
            "enabled": false,
            "instructions": [
              "AGENTS.md"
            ],
            "skills": [
              ".agents/skills"
            ]
          }
        },
        "path": {
          "default": "workspace",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "snapshots": {
          "default": true,
          "title": "Snapshots",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "title": "RawWorkspace",
      "type": "object"
    },
    "RecapPolicy": {
      "description": "When kinby writes a model-assisted recap.",
      "enum": [
        "every-turn",
        "off"
      ],
      "title": "RecapPolicy",
      "type": "string"
    },
    "SearchBackend": {
      "description": "The one service an instance sends its web searches to.",
      "enum": [
        "brave",
        "tavily",
        "exa",
        "searxng"
      ],
      "title": "SearchBackend",
      "type": "string"
    },
    "ToolState": {
      "description": "How one tool reaches an instance's turns (ADR 0129).",
      "enum": [
        "loaded",
        "searchable",
        "off"
      ],
      "title": "ToolState",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The shape of ``kinby.toml``, validated once at load.",
  "properties": {
    "browser": {
      "default": false,
      "title": "Browser",
      "type": "boolean"
    },
    "budgets": {
      "$ref": "#/$defs/RawBudgets",
      "title": "Budgets"
    },
    "compaction": {
      "$ref": "#/$defs/RawCompaction",
      "default": {
        "automatic": true,
        "trigger": 100000
      }
    },
    "feedback": {
      "$ref": "#/$defs/RawFeedback",
      "default": {
        "ask": "every-turn"
      }
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "memory": {
      "$ref": "#/$defs/RawMemory",
      "default": {
        "recap": "every-turn"
      }
    },
    "models": {
      "$ref": "#/$defs/RawModels"
    },
    "persona_name": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Persona Name"
    },
    "prices": {
      "additionalProperties": false,
      "patternProperties": {
        "^[^:\\s]+:[^:\\s]+(?![\\s\\S])": {
          "$ref": "#/$defs/RawModelPrice"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Prices",
      "type": "object"
    },
    "routines": {
      "$ref": "#/$defs/RawRoutines",
      "default": {
        "timezone": "UTC"
      }
    },
    "serve": {
      "anyOf": [
        {
          "$ref": "#/$defs/RawServe"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "state_dir": {
      "default": ".state",
      "minLength": 1,
      "title": "State Dir",
      "type": "string"
    },
    "tools": {
      "$ref": "#/$defs/RawTools",
      "default": {
        "authored": true,
        "bash_timeout_seconds": 120,
        "default_states": {},
        "defaults": true,
        "memory": true,
        "search": "brave",
        "states": {}
      }
    },
    "workspace": {
      "$ref": "#/$defs/RawWorkspace",
      "default": {
        "commands": {},
        "conventions": {
          "enabled": false,
          "instructions": [
            "AGENTS.md"
          ],
          "skills": [
            ".agents/skills"
          ]
        },
        "path": "workspace",
        "snapshots": true,
        "source": null
      }
    }
  },
  "required": [
    "id",
    "models"
  ],
  "title": "RawManifest",
  "type": "object"
}
