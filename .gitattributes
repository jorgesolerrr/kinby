# The container entrypoint must keep LF endings on every checkout.
docker/entrypoint.sh text eol=lf
# Preserve the vendored skill sources byte for byte on every checkout.
.claude/skills/** -text
# oxfmt checks for LF, so the TypeScript workspaces keep it on Windows checkouts too.
/apps/** text eol=lf
/packages/** text eol=lf
