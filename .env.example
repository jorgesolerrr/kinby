# Copy to .env and fill in. Names only; never commit values.

# Model provider keys, by the <PROVIDER>_API_KEY convention (kinby.instance.manifest.api_key_variable).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# The web search backend's key, for the backend [tools] search names (instance.SearchBackend.key_variable).
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SEARXNG_URL=

# Hub client: access token for `kinby` CLI commands that connect to a hub (contract_socket.TOKEN_VARIABLE).
KINBY_TOKEN=
# Contract server control token (core.contract_server.CONTROL_TOKEN_VARIABLE).
KINBY_CONTROL_TOKEN=
# Instance directory override (instance.discovery).
KINBY_INSTANCE=

# compose.hub.yaml
KINBY_DOMAIN=
KINBY_HUB_DIR=

# Container entrypoint (docker/entrypoint.sh).
GH_TOKEN=
GIT_USER_NAME=
GIT_USER_EMAIL=
