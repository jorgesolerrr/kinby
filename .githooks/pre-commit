#!/bin/sh
# Fast static checks before every commit: the lint and format steps CI runs.
# Tests and typechecks stay in `bun run check`. Enable per clone with
# `git config core.hooksPath .githooks`.
set -e
cd "$(git rev-parse --show-toplevel)"

uv run ruff check .
uv run ruff format --check .

for dir in apps/web packages/contract; do
	(cd "$dir" && bun x oxlint && bun x oxfmt --check)
done
